class BTree {

    class Node {
        int key[] = new int[3];
        Node child[] = new Node[4];
        int n = 0;
        boolean leaf = true;
    }

    Node root = new Node();

    void split(Node x, int i) {
        Node y = x.child[i];
        Node z = new Node();

        z.leaf = y.leaf;
        z.n = 1;
        z.key[0] = y.key[2];

        if (!y.leaf) {
            z.child[0] = y.child[2];
            z.child[1] = y.child[3];
        }

        y.n = 1;

        for (int j = x.n; j >= i + 1; j--)
            x.child[j + 1] = x.child[j];

        x.child[i + 1] = z;

        for (int j = x.n - 1; j >= i; j--)
            x.key[j + 1] = x.key[j];

        x.key[i] = y.key[1];
        x.n++;
    }

    void add(Node x, int k) {
        int i = x.n - 1;

        if (x.leaf) {
            while (i >= 0 && k < x.key[i]) {
                x.key[i + 1] = x.key[i];
                i--;
            }

            x.key[i + 1] = k;
            x.n++;
        }
        else {
            while (i >= 0 && k < x.key[i])
                i--;

            i++;

            if (x.child[i].n == 3) {
                split(x, i);

                if (k > x.key[i])
                    i++;
            }

            add(x.child[i], k);
        }
    }

    void insert(int k) {
        Node r = root;

        if (r.n == 3) {
            Node s = new Node();
            root = s;
            s.leaf = false;
            s.child[0] = r;

            split(s, 0);
            add(s, k);
        }
        else {
            add(r, k);
        }
    }

    void display(Node x) {
        int i;

        for (i = 0; i < x.n; i++) {
            if (!x.leaf)
                display(x.child[i]);

            System.out.print(x.key[i] + " ");
        }

        if (!x.leaf)
            display(x.child[i]);
    }

    public static void main(String[] args) {
        BTree tree = new BTree();

        tree.insert(10);
        tree.insert(20);
        tree.insert(5);
        tree.insert(6);
        tree.insert(12);
        tree.insert(30);

        System.out.println("B-Tree:");
        tree.display(tree.root);

        System.out.println("\nTime Complexity: O(log n)");
    }
}
