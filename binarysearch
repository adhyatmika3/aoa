class BinarySearch {
    public static void main(String[] args) {

        int a[] = {10, 20, 30, 40, 50};
        int key = 30;

        int low = 0;
        int high = a.length - 1;
        int found = -1;

        while (low <= high) {

            int mid = (low + high) / 2;

            if (a[mid] == key) {
                found = mid;
                break;
            }
            else if (key > a[mid]) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }

        if (found != -1)
            System.out.println("Element found at index: " + found);
        else
            System.out.println("Element not found");

        System.out.println("Time Complexity: O(log n)");
    }
}
